<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Ruijie"
    x:Name="WindMain" x:Class="FormMain"
    Title="锐捷 ePorta 连接工具" AllowsTransparency="True" WindowStyle="None"
    MinHeight="580" MinWidth="540" Width="600" Height="640"
    ResizeMode="CanResizeWithGrip" Background="{x:Null}"
    Icon="Images/icon.ico"
    WindowStartupLocation="CenterScreen">
    <Border x:Name="PanBack" Margin="10" CornerRadius="8" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.3" Color="#000000" />
        </Border.Effect>
        <Border x:Name="BorderForm" CornerRadius="8" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#f5f7fa" Offset="0" />
                    <GradientStop Color="#e8edf5" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid x:Name="PanForm">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Grid x:Name="PanTitle" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource ColorObject4}" Offset="0" />
                            <GradientStop Color="{StaticResource ColorObject3}" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
                        <TextBlock Text="锐捷 ePorta 连接工具" Foreground="White" FontSize="14" FontWeight="Bold" />
                        <TextBlock x:Name="LabVersion" Text="" Foreground="White" FontSize="11" Opacity="0.7" Margin="6,3,0,0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <local:MyIconButton x:Name="BtnTitleTray" Width="28" Height="28" Theme="White" Margin="0,0,4,0"
                                            Logo="F1 M5,0 L10,7 L15,0 L12,0 L10,4 L8,0 Z" LogoScale="0.72"
                                            ToolTip="隐藏到托盘"
                                            ToolTipService.InitialShowDelay="0"
                                            ToolTipService.BetweenShowDelay="0"
                                            Click="BtnTitleTray_Click" />
                        <local:MyIconButton x:Name="BtnTitleMin" Width="28" Height="28" Theme="White" Margin="0,0,4,0"
                                            Logo="F1 M0,0 h15 v2 h-15 v-2 Z" LogoScale="0.72"
                                            ToolTip="最小化"
                                            ToolTipService.InitialShowDelay="0"
                                            ToolTipService.BetweenShowDelay="0"
                                            Click="BtnTitleMin_Click" />
                        <local:MyIconButton x:Name="BtnTitleClose" Width="28" Height="28" Theme="White"
                                            Logo="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z" LogoScale="0.72"
                                            ToolTip="关闭"
                                            ToolTipService.InitialShowDelay="0"
                                            ToolTipService.BetweenShowDelay="0"
                                            Click="BtnTitleClose_Click" />
                    </StackPanel>
                </Grid>

                <!-- Tab Buttons -->
                <StackPanel x:Name="PanTabs" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Border x:Name="TabStatus" Width="80" Height="28" CornerRadius="4,4,0,0" Cursor="Hand"
                            Background="{StaticResource ColorBrush3}" Margin="0,0,2,0"
                            MouseLeftButtonDown="TabStatus_Click">
                        <TextBlock Text="状态" Foreground="White" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Border>
                    <Border x:Name="TabConfig" Width="80" Height="28" CornerRadius="4,4,0,0" Cursor="Hand"
                            Background="{StaticResource ColorBrushGray5}"
                            MouseLeftButtonDown="TabConfig_Click">
                        <TextBlock Text="配置" Foreground="{StaticResource ColorBrush1}" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Border>
                </StackPanel>

                <!-- Page Content -->
                <Border Grid.Row="2" CornerRadius="0,0,8,8" Background="White" ClipToBounds="True">
                    <Grid x:Name="PanPage">
                        <Frame x:Name="FraStatus" NavigationUIVisibility="Hidden" Visibility="Visible" />
                        <Frame x:Name="FraConfig" NavigationUIVisibility="Hidden" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
