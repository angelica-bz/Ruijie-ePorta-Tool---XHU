<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Ruijie"
    x:Class="PageConfig"
    Title="Config" Background="Transparent">
    <local:MyScrollViewer Margin="8" Padding="0,0,4,0">
        <Grid Margin="8,8,8,16">
            <!--
                校园网账号：普通用户只需要维护「学号 / 密码 / 网络类型」三项。
                服务器地址、登录路径、Cookie、queryString、请求头等抓包参数
                已全部由认证核心自动处理，不再出现在界面上。
            -->
            <local:MyCard x:Name="CardAccount" Title="校园网账号"
                          MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel Margin="15,38,15,14">

                    <!-- 旧配置迁移提示 -->
                    <local:MyHint x:Name="HintMigration" Theme="Yellow"
                                  Visibility="Collapsed" Margin="0,0,0,10" />
                    <!-- 未知网络类型提示 -->
                    <local:MyHint x:Name="HintUnknownService" Theme="Yellow"
                                  Visibility="Collapsed" Margin="0,0,0,10" />

                    <!-- 学号 -->
                    <TextBlock Text="学号" Foreground="{StaticResource ColorBrushGray2}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtUserId" FontSize="13" Margin="0,0,0,12" />

                    <!-- 密码 -->
                    <TextBlock Text="密码" Foreground="{StaticResource ColorBrushGray2}" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="TxtPassword" FontSize="13" />
                        <TextBox x:Name="TxtPasswordVisible" FontSize="13" Visibility="Collapsed" />
                        <local:MyTextButton x:Name="BtnTogglePassword" Grid.Column="1"
                                            Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
                    </Grid>
                    <TextBlock x:Name="LabPasswordHint" Foreground="{StaticResource ColorBrushGray2}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <local:MyTextButton x:Name="BtnClearPassword" HorizontalAlignment="Left"
                                        Margin="0,6,0,14" FontSize="12" Visibility="Collapsed" />

                    <!-- 网络类型 / 运营商 -->
                    <TextBlock Text="网络类型 / 运营商" Foreground="{StaticResource ColorBrushGray2}" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbOperator" Height="26" FontSize="13"
                              Background="White" BorderBrush="{StaticResource ColorBrushGray4}"
                              Padding="6,0" VerticalContentAlignment="Center">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="FontSize" Value="13" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <TextBlock Text="办公网 / 校内网 属于校内网络，不需要运营商账号。"
                               Foreground="{StaticResource ColorBrushGray2}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,4,0,0" />

                    <!-- 配置状态 -->
                    <Border Background="{StaticResource ColorBrushGray8}" CornerRadius="3"
                            BorderBrush="{StaticResource ColorBrushGray5}" BorderThickness="1"
                            Padding="10,8" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ShapeStatusDot" Width="10" Height="10"
                                     Fill="{StaticResource ColorBrushGray4}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="LabConfigStatus" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 保存 -->
                    <local:MyButton x:Name="BtnSaveConfig" Text="保存配置" ColorType="Highlight"
                                    HorizontalAlignment="Right" Padding="24,6" Margin="0,14,0,0" />
                </StackPanel>
            </local:MyCard>
        </Grid>
    </local:MyScrollViewer>
</Page>
