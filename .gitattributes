# ============================================================================
# 换行与文本处理规则
# ----------------------------------------------------------------------------
# 本项目是 VB.NET / WPF 的 Windows 桌面程序，约定：
#
#   仓库内部（git 对象）  —— 一律以 LF 存储
#   工作区（检出到磁盘）  —— 一律以 CRLF 呈现
#
# 这样无论贡献者的 core.autocrlf 设成什么，结果都一致：
# Windows 上得到 CRLF（Visual Studio / MSBuild 友好），
# 其它平台拉下来做检索、比对时也不会因为行尾差异产生假 diff。
#
# 与 .editorconfig 的 end_of_line = crlf 保持一致；
# 但 .editorconfig 只对支持的编辑器生效，管不住 git 本身，所以需要这个文件。
# ============================================================================

# 默认：由 git 自动识别文本文件，检出时统一为 CRLF
* text=auto eol=crlf

# ---------------------------------------------------------------------------
# 明确的文本类型（防止个别文件被误判成二进制而不做行尾转换）
# ---------------------------------------------------------------------------
*.vb            text
*.xaml          text
*.vbproj        text
*.sln           text
*.config        text
*.xml           text
*.md            text
*.yml           text
*.yaml          text
*.json          text
*.txt           text
*.editorconfig  text
.gitignore      text
.gitattributes  text

# ---------------------------------------------------------------------------
# 二进制：绝不参与行尾转换（改了会直接损坏文件）
# binary = -text -diff；再显式 -eol，避免上面那条 eol=crlf 落到这些文件上
# ---------------------------------------------------------------------------
*.png   binary -eol
*.jpg   binary -eol
*.jpeg  binary -eol
*.gif   binary -eol
*.bmp   binary -eol
*.ico   binary -eol
*.exe   binary -eol
*.dll   binary -eol
*.pdb   binary -eol
*.vsidx binary -eol
*.suo   binary -eol

# ---------------------------------------------------------------------------
# 生成物：不参与 diff 展示，避免刷屏
# ---------------------------------------------------------------------------
*.xml   -diff
*.pdb   -diff
